# Copy to .env and fill in. Only BOT_TOKEN is required; the rest have sane defaults.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:your-telegram-bot-token

# Redis (aiogram FSM storage)
REDIS_URL=redis://localhost:6379/0

# Async SQLAlchemy database URL
DATABASE_URL=sqlite+aiosqlite:///./almatrack.db

# Admin web dashboard — CHANGE THESE before any real deployment
DASHBOARD_LOGIN=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_SECRET_KEY=change-me-to-a-long-random-string

# FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Flask admin server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Premium emoji IDs (optional; leave empty to fall back to regular emoji).
# Forward a custom emoji to @getidsbot to find its id.
# EMOJI_STAR=
# EMOJI_FIRE=
# EMOJI_TROPHY=
